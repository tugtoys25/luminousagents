-- Run manually against the intended D1 database. Never commit a real email, hash or user id.
-- Normally you do NOT need this: create the first super administrator at /admin/setup and add
-- everyone else from /dashboard/staff/ui. Use this only for recovery or when email is not configured.
--
-- 1. Generate a hash locally:   node scripts/hash-password.mjs
-- 2a. Create a staff user:
INSERT INTO users (id, email, display_name, user_type, role, status, password_hash, password_updated_at, must_change_password, created_at, updated_at)
VALUES ('REPLACE_WITH_RANDOM_UUID', 'staff@example.com', 'Staff Member', 'staff', 'admin', 'active', 'REPLACE_WITH_HASH', datetime('now'), 1, datetime('now'), datetime('now'));
