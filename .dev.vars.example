# Local-only examples. Never commit actual credentials.
# APP_ENV is configured in wrangler.jsonc.
# Add secrets only when their corresponding sprint implements and validates them.
# TURNSTILE_SECRET_KEY=
# IP_HASH_SECRET=
# RESEND_API_KEY=
# SESSION_HMAC_SECRET=

# Staff and buyers sign in with email + password; no identity-provider settings are needed.

# Non-secret public key for the Turnstile widget (configure in Wrangler vars).
# TURNSTILE_SITE_KEY=

# Sprint 5 notification delivery. Use test credentials in development only.
# RESEND_API_KEY=re_...
# OTP_ENCRYPTION_KEY=base64-encoded-32-random-bytes   (encrypts password-reset links in the notification queue)
# EMAIL_FROM=Casinos of Mayfair <notifications@example.com>
# OPS_EMAIL=operations@example.com
# PUBLIC_BASE_URL=https://casinosofmayfair.com
# Sprint 10 malware scanner adapter (configure only with a trusted scanner endpoint).
# MALWARE_SCANNER_API_URL=https://scanner.internal.example
# MALWARE_SCANNER_API_TOKEN=
# MALWARE_SCANNER_SIGNING_SECRET=generate-a-random-secret-of-at-least-32-bytes
# MALWARE_SCANNER_PROVIDER=your-provider-id
# IP_HASH_SECRET=generate-a-separate-random-secret
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CACHE_PURGE_TOKEN=zone-scoped-cache-purge-token

# Sprint 12/14: set only for the one-time first super-administrator setup (/admin/setup); use a random secret of at least 32 characters.
# ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token

# P0 hardening
# TURNSTILE_ENFORCEMENT=log-only          (temporary rollout switch only)
# MFA_ENCRYPTION_KEY=base64-encoded-32-random-bytes   (optional; falls back to OTP_ENCRYPTION_KEY)
# STAFF_MFA_REQUIRED_ROLES=super_admin,admin
# LOG_LEVEL=info

# Seller enquiry workflow (/sell-a-casino). No production values are invented here.
# SELLER_EMAIL_FROM=Casinos of Mayfair Brokerage <brokerage@example.com>   (verified sender; falls back to EMAIL_FROM)
# SELLER_REPLY_TO=brokerage@example.com
# SELLER_ALERT_RECIPIENTS=broker1@example.com,broker2@example.com          (required for internal alerts)
# SELLER_ALERT_INCLUDE_PHONE=false
# SELLER_ALERT_INCLUDE_PRICE=false
# SELLER_COMPANY_WEBSITE=https://casinosofmayfair.com
# SELLER_MARKETING_CONSENT_ENABLED=false                                   (enable only after legal review)
# SELLER_REMINDERS_ENABLED=true
# SELLER_REMINDER_INTERVAL_HOURS=24
# SELLER_ESCALATION_AFTER_HOURS=48          (unset or 0 disables escalation)
# SELLER_ESCALATION_RECIPIENTS=manager@example.com
